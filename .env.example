# Token from @BotFather
BOT_TOKEN=123456:ABC-your-token
# Channel where deals are posted (add the bot as admin there)
CHANNEL_ID=@your_channel
# Which deals are interesting
MIN_DISCOUNT=50
MIN_REVIEWS=300
MIN_POSITIVE=70
MAX_SCAN=2000
# Single posts per run (only record-low prices when RECORDS_ONLY=true)
POSTS_PER_CHECK=2
RECORDS_ONLY=true
# Daily digest (image + list) at this hour, Kyiv time; -1 disables it
DIGEST_HOUR=20
DIGEST_PARTS=3
# Always-on mode only
CHECK_EVERY_MIN=30
