# Token from @BotFather
BOT_TOKEN=123456:ABC-your-token
# Channel where deals are posted (add the bot as admin there)
CHANNEL_ID=@your_channel
# Which deals are interesting
MIN_DISCOUNT=50
MIN_REVIEWS=5000
MIN_POSITIVE=70
MAX_SCAN=2000
# Occasional single posts for record-low prices
POSTS_PER_CHECK=1
MAX_SINGLES_PER_DAY=2
RECORDS_ONLY=true
# Digest posts (cover image + list), Kyiv hours; empty disables them
DIGEST_HOURS=13,20
# Always-on mode only
CHECK_EVERY_MIN=30
